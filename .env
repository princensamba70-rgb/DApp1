# ═══════════════════════════════════════════════════════════════
# CORTEXP — environnement de DÉVELOPPEMENT (valeurs par défaut sûres)
# ⚠ EN PRODUCTION : changez AUTH_SECRET (openssl rand -base64 32) et
#   ADMIN_PASSWORD, puis placez vos vrais secrets dans .env.local (ignoré par Git).
# ═══════════════════════════════════════════════════════════════

# ── Base de données (SQLite, chemin relatif à la racine du projet) ──
DATABASE_URL="file:./data/cortexp.db"

# ── Auth.js (sessions JWT httpOnly) ──
AUTH_SECRET=dev-secret-change-me-0123456789abcdef
AUTH_TRUST_HOST=true
# AUTH_URL=http://localhost:3000

# ── Compte administrateur (haché bcrypt au seed, jamais exposé au navigateur) ──
ADMIN_USERNAME=adminnp
ADMIN_PASSWORD=2026@admin@prince
ADMIN_EMAIL=admin@cortexp.local

# ── Mode 2 : Google OAuth (vide = bouton désactivé) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Mode 3 : GitHub OAuth (vide = bouton désactivé) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Moteur d'agent (DEMO_MODE=true : navigable sans clé API) ──
DEMO_MODE=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_AGENT=claude-sonnet-4-5
ANTHROPIC_MODEL_KINGLY=claude-sonnet-4-5

# ── Quota par défaut des nouveaux comptes (messages/jour) ──
DEFAULT_DAILY_MESSAGE_LIMIT=50
