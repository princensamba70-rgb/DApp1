{
  "name": "cortexp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "check:env": "node --env-file-if-exists=.env scripts/check-env.mjs",
    "db:push": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "setup": "node scripts/prisma-generate.mjs && npm run check:env && npm run db:push && npm run db:seed",
    "postinstall": "node scripts/prisma-generate.mjs",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-better-sqlite3": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}