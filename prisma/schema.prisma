// CORTEXP — schéma de données (SQLite en local, compatible Postgres en changeant le provider)
generator client {
  provider        = "prisma-client-js"
  // Query compiler WASM + driver adapters : aucun binaire Prisma à télécharger.
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Utilisateurs & Auth.js ────────────────────────────────────
model User {
  id                String    @id @default(cuid())
  username          String?   @unique
  email             String?   @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  // Haché avec bcrypt — jamais exposé au client, jamais loggé.
  passwordHash      String?
  role              String    @default("USER") // USER | ADMIN
  plan              String    @default("free") // free | pro | team
  // Limite de messages / jour. null = illimité.
  dailyMessageLimit Int?      @default(50)
  isActive          Boolean   @default(true)
  defaultMode       String    @default("agent") // agent | kingly
  createdAt         DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  chatSessions ChatSession[]
  runs         Run[]
  usages       Usage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Sessions de chat agentique ───────────────────────────────
model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("Nouvelle session")
  mode      String    @default("agent") // agent | kingly
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  runs     Run[]

  @@index([userId, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user | assistant
  content   String
  // JSON : plan, appels d'outils, sous-agents, citations — pour rejouer l'UI.
  meta      String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Run {
  id        String    @id @default(cuid())
  sessionId String
  userId    String
  mode      String
  status    String    @default("running") // running | success | partial | failed
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  tokensIn  Int       @default(0)
  tokensOut Int       @default(0)
  costUsd   Float     @default(0)

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// ── Quotas & audit ───────────────────────────────────────────
model Usage {
  id        String @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD (UTC)
  messages  Int    @default(0)
  tokensIn  Int    @default(0)
  tokensOut Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
