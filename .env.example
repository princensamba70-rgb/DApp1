# Copier en .env, remplacer TOUS les secrets avant tout deploiement.
APP_PORT=8080
POSTGRES_DB=survey_quality
POSTGRES_USER=survey_quality
POSTGRES_PASSWORD=change_me_use_a_long_random_password

# Comptes initialises UNIQUEMENT lors de la creation de la base (pas reinitialises au redemarrage).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
USER1_USERNAME=user1
USER1_PASSWORD=change_me_user

# Cle AES-256-GCM : openssl rand -base64 32 (32 octets apres decodage).
SURVEY_ENCRYPTION_KEY=change_me_base64_key_32_bytes
# Valeur globale héritée pour les configurations HTTP antérieures ; laisser false.
# Un administrateur peut autoriser explicitement HTTP pour une connexion donnée dans l’interface.
SURVEY_ALLOW_HTTP=false
# Mettre true derriere un reverse proxy HTTPS en production.
SESSION_COOKIE_SECURE=false
SYNC_INTERVAL_MINUTES=60
