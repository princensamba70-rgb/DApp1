# ═══════════════════════════════════════════════════════════════
# CORTEXP — modèle de configuration (copier vers .env puis adapter)
#   cp .env.example .env
# Les valeurs <...> sont fictives et doivent être remplacées.
# ═══════════════════════════════════════════════════════════════

# ── Base de données ───────────────────────────────────────────
# SQLite par défaut (zéro dépendance). En Docker : file:/app/data/cortexp.db
DATABASE_URL="file:./data/cortexp.db"

# ── Auth.js — OBLIGATOIRE ─────────────────────────────────────
# Générer : openssl rand -base64 32
AUTH_SECRET=<generer-avec-openssl-rand-base64-32>
AUTH_TRUST_HOST=true
# URL publique (utile derrière un proxy) :
# AUTH_URL=http://localhost:3000

# ── Compte administrateur (créé/synchronisé au démarrage) ─────
# Le mot de passe est haché bcrypt côté serveur : jamais en clair en base,
# jamais renvoyé par l'API, jamais visible dans le navigateur.
ADMIN_USERNAME=adminnp
ADMIN_PASSWORD=<mot-de-passe-admin-fort>
ADMIN_EMAIL=admin@cortexp.local

# ── Mode 2 : connexion Google (facultatif — vide = bouton désactivé) ──
# Callback : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Mode 3 : connexion GitHub (facultatif — vide = bouton désactivé) ──
# Callback : http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Moteur d'agent ────────────────────────────────────────────
# DEMO_MODE=true : app entièrement navigable sans clé API (simulation réaliste).
# DEMO_MODE=false + ANTHROPIC_API_KEY : génération réelle.
DEMO_MODE=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_AGENT=claude-sonnet-4-5
ANTHROPIC_MODEL_KINGLY=claude-sonnet-4-5

# ── Quotas (messages/jour des nouveaux comptes ; modifiable par l'admin) ──
DEFAULT_DAILY_MESSAGE_LIMIT=50
